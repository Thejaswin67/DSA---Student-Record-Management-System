#include <iostream>
#include <fstream>
#include <sstream>
#include <iomanip>
#include <limits>
#include <utility>
using namespace std;

struct Student {
    int id;
    string name;
    int age;
    string department;
    float marks;
    string phone;
};

struct Node {
    Student student;
    Node* next;
};

Node* head = nullptr;
int studentCount = 0;

void clearInput() {
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
}

Node* findStudent(int id) {
    Node* current = head;

    while (current != nullptr) {
        if (current->student.id == id) {
            return current;
        }

        current = current->next;
    }

    return nullptr;
}

void insertStudent(const Student& student) {
    Node* newNode = new Node;

    newNode->student = student;
    newNode->next = head;

    head = newNode;
    studentCount++;
}

void printHeading() {
    cout << left
         << setw(8) << "ID"
         << setw(22) << "NAME"
         << setw(6) << "AGE"
         << setw(16) << "DEPARTMENT"
         << setw(10) << "MARKS"
         << "PHONE\n";

    cout << string(75, '-') << '\n';
}

void printStudent(const Student& student) {
    cout << left
         << setw(8) << student.id
         << setw(22) << student.name
         << setw(6) << student.age
         << setw(16) << student.department
         << setw(10) << fixed << setprecision(1) << student.marks
         << student.phone << '\n';
}

void addStudent() {
    Student student;

    cout << "ID: ";
    cin >> student.id;
    clearInput();

    if (findStudent(student.id) != nullptr) {
        cout << "A student with this ID already exists.\n";
        return;
    }

    cout << "Name: ";
    getline(cin, student.name);

    cout << "Age: ";
    cin >> student.age;
    clearInput();

    cout << "Department: ";
    getline(cin, student.department);

    cout << "Marks: ";
    cin >> student.marks;
    clearInput();

    cout << "Phone: ";
    getline(cin, student.phone);

    if (student.marks < 0 || student.marks > 100) {
        cout << "Marks must be between 0 and 100.\n";
        return;
    }

    insertStudent(student);
    cout << "Student added successfully.\n";
}

void displayStudents() {
    if (head == nullptr) {
        cout << "No student records available.\n";
        return;
    }

    cout << "\nTotal students: " << studentCount << "\n\n";
    printHeading();

    Node* current = head;

    while (current != nullptr) {
        printStudent(current->student);
        current = current->next;
    }
}

void searchStudent() {
    int id;

    cout << "Enter student ID: ";
    cin >> id;
    clearInput();

    Node* studentNode = findStudent(id);

    if (studentNode == nullptr) {
        cout << "Student not found.\n";
        return;
    }

    printHeading();
    printStudent(studentNode->student);
}

void updateStudent() {
    int id;
    int choice;

    cout << "Enter student ID: ";
    cin >> id;
    clearInput();

    Node* studentNode = findStudent(id);

    if (studentNode == nullptr) {
        cout << "Student not found.\n";
        return;
    }

    cout << "\n1. Name\n"
         << "2. Age\n"
         << "3. Department\n"
         << "4. Marks\n"
         << "5. Phone\n"
         << "Choose a field to update: ";

    cin >> choice;
    clearInput();

    Student& student = studentNode->student;

    switch (choice) {
        case 1:
            cout << "New name: ";
            getline(cin, student.name);
            break;

        case 2:
            cout << "New age: ";
            cin >> student.age;
            clearInput();
            break;

        case 3:
            cout << "New department: ";
            getline(cin, student.department);
            break;

        case 4: {
            float newMarks;

            cout << "New marks: ";
            cin >> newMarks;
            clearInput();

            if (newMarks < 0 || newMarks > 100) {
                cout << "Marks must be between 0 and 100.\n";
                return;
            }

            student.marks = newMarks;
            break;
        }

        case 5:
            cout << "New phone: ";
            getline(cin, student.phone);
            break;

        default:
            cout << "Invalid choice.\n";
            return;
    }

    cout << "Student updated successfully.\n";
}

void deleteStudent() {
    int id;

    cout << "Enter student ID: ";
    cin >> id;
    clearInput();

    Node* current = head;
    Node* previous = nullptr;

    while (current != nullptr && current->student.id != id) {
        previous = current;
        current = current->next;
    }

    if (current == nullptr) {
        cout << "Student not found.\n";
        return;
    }

    if (previous == nullptr) {
        head = current->next;
    } else {
        previous->next = current->next;
    }

    delete current;
    studentCount--;

    cout << "Student deleted successfully.\n";
}

bool shouldSwap(
    const Student& first,
    const Student& second,
    int choice
) {
    switch (choice) {
        case 1:
            return first.marks < second.marks;
        case 2:
            return first.marks > second.marks;
        case 3:
            return first.id > second.id;
        case 4:
            return first.id < second.id;
        case 5:
            return first.name > second.name;
        case 6:
            return first.name < second.name;
        default:
            return false;
    }
}

void sortStudents() {
    if (head == nullptr) {
        cout << "No student records available.\n";
        return;
    }

    int choice;

    cout << "\n1. Marks: highest first\n"
         << "2. Marks: lowest first\n"
         << "3. ID: ascending\n"
         << "4. ID: descending\n"
         << "5. Name: A-Z\n"
         << "6. Name: Z-A\n"
         << "Choice: ";

    cin >> choice;
    clearInput();

    if (choice < 1 || choice > 6) {
        cout << "Invalid choice.\n";
        return;
    }

    Student* students = new Student[studentCount];
    Node* current = head;

    for (int index = 0; index < studentCount; index++) {
        students[index] = current->student;
        current = current->next;
    }

    for (int pass = 0; pass < studentCount - 1; pass++) {
        for (int index = 0; index < studentCount - pass - 1; index++) {
            if (shouldSwap(students[index], students[index + 1], choice)) {
                swap(students[index], students[index + 1]);
            }
        }
    }

    printHeading();

    for (int index = 0; index < studentCount; index++) {
        printStudent(students[index]);
    }

    delete[] students;
}

void saveStudents() {
    ofstream file("students.csv");

    if (!file) {
        cout << "Could not open the file for saving.\n";
        return;
    }

    file << "ID,Name,Age,Dept,Marks,Phone\n";

    Node* current = head;

    while (current != nullptr) {
        const Student& student = current->student;

        file << student.id << ','
             << student.name << ','
             << student.age << ','
             << student.department << ','
             << student.marks << ','
             << student.phone << '\n';

        current = current->next;
    }

    if (file) {
        cout << "Student records saved.\n";
    } else {
        cout << "Could not save all student records.\n";
    }
}

void loadStudents() {
    ifstream file("students.csv");

    if (!file) {
        cout << "No saved file found. Starting fresh.\n";
        return;
    }

    string line;
    getline(file, line);

    while (getline(file, line)) {
        stringstream record(line);
        Student student;
        string idText;
        string ageText;
        string marksText;

        if (!getline(record, idText, ',') ||
            !getline(record, student.name, ',') ||
            !getline(record, ageText, ',') ||
            !getline(record, student.department, ',') ||
            !getline(record, marksText, ',')) {
            cout << "Skipped an invalid record.\n";
            continue;
        }

        getline(record, student.phone);

        try {
            student.id = stoi(idText);
            student.age = stoi(ageText);
            student.marks = stof(marksText);
        } catch (const exception&) {
            cout << "Skipped an invalid record.\n";
            continue;
        }

        if (student.marks < 0 || student.marks > 100 ||
            findStudent(student.id) != nullptr) {
            cout << "Skipped an invalid or duplicate record.\n";
            continue;
        }

        insertStudent(student);
    }

    cout << "Student records loaded.\n";
}

void exportReport() {
    if (head == nullptr) {
        cout << "No student records available.\n";
        return;
    }

    ofstream file("students_report.txt");

    if (!file) {
        cout << "Could not create the report.\n";
        return;
    }

    file << "STUDENT REPORT\n"
         << "Total students: " << studentCount << "\n\n";

    Node* current = head;
    int recordNumber = 1;

    while (current != nullptr) {
        const Student& student = current->student;

        file << "Record " << recordNumber << '\n'
             << "ID: " << student.id << '\n'
             << "Name: " << student.name << '\n'
             << "Age: " << student.age << '\n'
             << "Department: " << student.department << '\n'
             << "Marks: " << fixed << setprecision(1)
             << student.marks << '\n'
             << "Phone: " << student.phone << "\n\n";

        current = current->next;
        recordNumber++;
    }

    if (file) {
        cout << "Report exported successfully.\n";
    } else {
        cout << "Could not write the complete report.\n";
    }
}

void showStatistics() {
    if (head == nullptr) {
        cout << "No student records available.\n";
        return;
    }

    double totalMarks = 0;
    double totalAge = 0;
    float highestMarks = head->student.marks;
    float lowestMarks = head->student.marks;

    Node* current = head;

    while (current != nullptr) {
        const Student& student = current->student;

        totalMarks += student.marks;
        totalAge += student.age;

        if (student.marks > highestMarks) {
            highestMarks = student.marks;
        }

        if (student.marks < lowestMarks) {
            lowestMarks = student.marks;
        }

        current = current->next;
    }

    cout << fixed << setprecision(2)
         << "\nSTUDENT STATISTICS\n"
         << "Total students: " << studentCount << '\n'
         << "Average marks: " << totalMarks / studentCount << '\n'
         << "Average age: " << totalAge / studentCount << '\n'
         << "Highest marks: " << highestMarks << '\n'
         << "Lowest marks: " << lowestMarks << '\n'
         << "Marks range: " << highestMarks - lowestMarks << '\n';
}

void freeMemory() {
    while (head != nullptr) {
        Node* nodeToDelete = head;
        head = head->next;
        delete nodeToDelete;
    }

    studentCount = 0;
}

int main() {
    cout << "STUDENT RECORD MANAGEMENT SYSTEM\n"
         << "Team: Formula 4\n\n";

    loadStudents();

    int choice = 0;

    do {
        cout << "\nMENU\n"
             << "1. Add student\n"
             << "2. Display students\n"
             << "3. Search student\n"
             << "4. Update student\n"
             << "5. Delete student\n"
             << "6. Sort students\n"
             << "7. Save records\n"
             << "8. Export report\n"
             << "9. Show statistics\n"
             << "10. Exit\n"
             << "Choice: ";

        if (!(cin >> choice)) {
            if (cin.eof()) {
                break;
            }

            cin.clear();
            clearInput();
            cout << "Please enter a number.\n";
            continue;
        }

        clearInput();

        switch (choice) {
            case 1: addStudent(); break;
            case 2: displayStudents(); break;
            case 3: searchStudent(); break;
            case 4: updateStudent(); break;
            case 5: deleteStudent(); break;
            case 6: sortStudents(); break;
            case 7: saveStudents(); break;
            case 8: exportReport(); break;
            case 9: showStatistics(); break;
            case 10: break;
            default: cout << "Invalid choice.\n";
        }
    } while (choice != 10);

    saveStudents();
    freeMemory();

    cout << "Program closed.\n";
    return 0;
}
